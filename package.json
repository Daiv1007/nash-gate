{
  "name": "nash-gate",
  "version": "0.1.0",
  "description": "Game-theoretic consensus gate for multi-agent AI systems",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./oracle": "./src/oracle/index.ts",
    "./adapters": "./src/adapters/index.ts",
    "./engine": "./src/engine/index.ts",
    "./server": "./src/server/dashboard.ts"
  },
  "scripts": {
    "test": "node --test",
